{
    // Unix socket path. Empty means use Sublime's cache dir.
    "socket_path": "",

    // If true, allow the generic run_window_command and run_text_command RPC methods.
    "allow_run_command": true,

    // Allow run_window_command/run_text_command for these commands. Empty means all commands
    // are allowed when allow_run_command is true.
    "command_allowlist": [],

    // Stop the bridge after this many seconds without an authorized RPC request.
    // If Sublime restarts before this deadline expires, the bridge starts again.
    "idle_timeout_seconds": 3600,

    // Maximum response body size for panel/view/console text returned via RPC.
    "max_text_bytes": 524288,

    // Maximum number of console log messages to keep in memory while the bridge is running.
    "console_log_max_entries": 2000
}
